{
	"permissions": {
		"allow": [
			"Bash(zig build*)",
			"Bash(zig fmt*)",
			"Bash(qemu-system-x86_64*)",
			"Bash(qemu-system-aarch64*)",
			"Bash(cat /tmp/*.log)",
			"Bash(grep* /tmp/*.log)",
			"Bash(objdump*)",
			"Bash(readelf*)",
			"Bash(nm *)",
			"Bash(rg * src/ library/ apps/)",
			"Bash(git log*)",
			"Bash(git diff*)",
			"Bash(git status)",
			"Bash(git add*)",
			"Bash(git commit*)"
		],
		"deny": [
			"Bash(git push*)",
			"mcp__github__push_files",
			"mcp__github__create_or_update_file",
			"mcp__github__delete_file",
			"mcp__github__create_pull_request",
			"mcp__github__merge_pull_request",
			"Bash(rm -rf *)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			},
			{
				"matcher": "compact",
				"hooks": [
					{
						"type": "command",
						"command": "echo 'INNIGKEIT CONTEXT RESTORED AFTER COMPACTION. Re-orient before continuing: read CLAUDE.md and docs/roadmap.md.\nVerification gate: zig build verify -Darm=true (counts: docs/test-baselines.md).\nzig build check does NOT validate inline assembly: run build_all or a real kernel build after touching arch asm.\nNever git push or open a PR unless the owner explicitly asks in that specific instance; commit locally and deliver patches.'"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-protect.sh"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-fmt.sh",
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh",
						"timeout": 300
					}
				]
			}
		]
	}
}
